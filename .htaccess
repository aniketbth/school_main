<?php
header('Content-Security-Policy: default-src "self" https:; img-src "self" data: https:; script-src "self" https://cdn.jsdelivr.net https://code.jquery.com https://cdn.datatables.net 'unsafe-inline'; style-src "self" 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src "self" https://fonts.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none';');
header('X-Frame-Options: DENY');
header('X-Content-Type-Options: nosniff');
header('Referrer-Policy: strict-origin-when-cross-origin');

if (strpos($_SERVER['REQUEST_URI'], '/config') !== false || strpos($_SERVER['REQUEST_URI'], '/includes') !== false || strpos($_SERVER['REQUEST_URI'], '.sql') !== false || strpos($_SERVER['REQUEST_URI'], '.log') !== false || strpos($_SERVER['REQUEST_URI'], '.env') !== false) {
    http_response_code(403);
    exit('Forbidden');
}

if (substr_count($_SERVER['REQUEST_URI'], '/') > 2) {
    $uri = parse_url($_SERVER['REQUEST_URI'], PHP_URL_PATH);
    $clean = ltrim($uri, '/');
    if (strpos($clean, '.php') === false && !empty($clean)) {
        $path = __DIR__ . '/' . $clean;
        if (is_file($path . '.php')) {
            include $path . '.php';
            exit;
        }
    }
}

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteRule ^index\.php$ / [L,R=301]
RewriteRule ^(.+)\.php$ /$1 [L,R=301]

Options -Indexes
ErrorDocument 403 /403.php
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php

<FilesMatch "\.(sql|log|env)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(htaccess|htpasswd)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|webp|ico|woff2|woff|ttf|pdf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^/uploads/ [NC]
    RewriteRule .* - [F,L]
</IfModule>

<IfModule mod_php.c>
    php_flag engine on
</IfModule>
